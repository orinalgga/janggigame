{
  "name": "janggi-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "app:build": "vue-tsc -b && vite build --mode app && cap sync",
    "app:android": "npm run app:build && cap open android",
    "app:ios": "npm run app:build && cap open ios",
    "avatar:parts": "esbuild scripts/avatar-parts/main.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/avatar-parts.mjs --log-level=warning && node node_modules/.tmp/avatar-parts.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@stomp/stompjs": "7.2.1",
    "vue": "3.5.12"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-vue": "5.1.4",
    "@vue/tsconfig": "0.5.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vue-tsc": "2.1.10"
  }
}
