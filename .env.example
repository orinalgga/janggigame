# .env로 복사해서 값을 채웁니다. .env는 git에 올라가지 않습니다.
# VS Code의 "서버 (구글 로그인)" 실행 구성과 docker compose가 이 파일을 읽습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32자 이상 임의 문자열. 로컬에서는 비워 두면 개발용 기본값을 씁니다(docker compose는 필수).
JANGGI_JWT_SECRET=
# 넣으면 AI 대국 채팅에서 Claude가 답합니다. 비워 두면 정해 둔 말로 답합니다.
ANTHROPIC_API_KEY=
# 관리자 페이지를 쓸 구글 메일. 쉼표로 여러 개.
JANGGI_ADMIN_EMAILS=
# 로컬에서 Postgres(docker)에 기보를 남기려면 아래 주석을 풉니다.
# DB_URL=jdbc:postgresql://localhost:5432/janggi
# DB_USER=janggi
# DB_PASSWORD=janggi
